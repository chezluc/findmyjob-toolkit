{
  "manifest_version": 3,
  "name": "General Chrome Console Bridge",
  "version": "0.2.0",
  "description": "Bridge-tab Chrome extension for background snippet execution and structured page extraction.",
  "permissions": [
    "activeTab",
    "tabs",
    "debugger",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:4471/*",
    "http://localhost:4471/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
